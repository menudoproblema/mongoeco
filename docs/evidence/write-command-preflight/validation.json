  "contract_source": "Explicit request to correct the two reviewed command preflight and writeConcern defects, add corpus regressions and verify MongoDB7/8/9 parity in sync/async and Memory/SQLite, including codes, counters, partial effects and connection reuse.",
  "fixes": [
    {
      "behavior": "Validate every update/delete hint, collation and sort shape before the first write; retain per-item missing-index failures and ordered/unordered partial effects.",
      "files": [
        "src/mongoeco/api/_async/_database_admin_write_commands.py",
        "src/mongoeco/api/_async/_write_command_validation.py"
      ]
    },
    {
      "behavior": "Validate writeConcern before effects and determine acknowledgement from normalized w, j and fsync; preserve acknowledged counts and duplicate errors for w:0 with synchronization.",
      "files": [
        "src/mongoeco/api/_async/_write_command_validation.py"
      ]
    }
  ],
  "dialect_deltas": [
    "MongoDB7 rejects any update sort presence with40415, including null.",
