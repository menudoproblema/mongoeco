    "queryOperators": [
      "$geoWithin",
      "$geoIntersects",
      "$near",
      "$nearSphere"
    ],
    "aggregationStages": [
      "$geoNear"
    ],
    "projectsFromCapability": "read",
    "note": "The embedded runtime uses planar local geometry operations. $nearSphere and 2dsphere remain Mongo-like names over local planar distance."
  }
